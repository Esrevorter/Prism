{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "Prism Wallet",
    "version": "0.1.10"
  },
  "build": {
    "distDir": "../dist",
    "devPath": "../dist",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "app.prism.wallet",
      "publisher": "Project Prism",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": ["binaries/prism-gui"],
      "category": "Finance",
      "windows": {
        "nsis": {
          "installMode": "currentUser"
        }
      },
      "macOS": {
        "minimumSystemVersion": "10.15"
      },
      "deb": {
        "depends": []
      },
      "shortDescription": "Prism — privacy-first desktop wallet",
      "longDescription": "Prism privacy-first desktop wallet (double-click installer shell, spec §13)."
    },
    "allowlist": {
      "shell": {
        "sidecar": true,
        "scope": [
          {
            "name": "binaries/prism-gui",
            "cmd": "",
            "args": true
          }
        ]
      }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; script-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Prism Wallet",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
